{
  "benchmark": {
    "scheduler": "throttler",
    "max_concurrent_requests": 64,
    "runtime_seconds": 10,
    "thread_count": 8,
    "allow_retries": false,
    "max_retries": 3,
    "adaptive_tuning": false,
