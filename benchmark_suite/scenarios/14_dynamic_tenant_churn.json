{
  "benchmark": {
    "scheduler": "throttler",
    "max_concurrent_requests": 128,
    "runtime_seconds": 6,
    "thread_count": 8,
    "allow_retries": false,
    "max_retries": 3,
    "at_limit": "reject",
    "at_limit_threshold_s": 1.0,
    "uniform_cost": true,
    "load_model": "open_loop",
    "capacity_relative": false,
    "max_inflight": 10000
  },
  "backend": {
    "cluster_base_latency_ms": 5.0,
    "cluster_capacity": 64,
    "congestion_factor": 3.0,
    "spike_amplitude_ms": 0.0,
    "spike_interval_s": 5.0,
    "spike_duration_s": 1.0,
    "jitter_pct": 0.05
  },
  "dmclock": {
    "admin": {
      "res": 10.0,
      "wgt": 100.0,
      "lim": 50.0
    },
    "auth": {
      "res": 5.0,
      "wgt": 50.0,
      "lim": 25.0
    },
    "data": {
      "res": 20.0,
      "wgt": 100.0,
      "lim": 100.0
    },
    "metadata": {
      "res": 10.0,
      "wgt": 50.0,
      "lim": 50.0
    }
  },
  "op_costs": {
    "ProbeHealth": 1,
    "GetSmall": 1,
    "PutSmall": 1,
    "GetLarge": 1,
    "PutLarge": 1,
    "ListBucket": 1
  },
  "op_latency_multipliers": {
    "ProbeHealth": 0.5,
    "GetSmall": 1.0,
    "PutSmall": 1.5,
    "GetLarge": 4.0,
    "PutLarge": 6.0,
    "ListBucket": 5.0
  },
