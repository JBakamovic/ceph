{
    "benchmark": {
        "scheduler": "dmclock_fine",
        "runtime_seconds": 10,
        "thread_count": 16,
        "max_concurrent_requests": 512,
        "allow_retries": false,
        "max_retries": 3,
        "adaptive_tuning": false,
        "adaptive_target_latency_ms": 3.0,
        "adaptive_sample_interval_ms": 50
    },
    "backend": {
        "cluster_capacity": 256,
        "cluster_base_latency_ms": 1.5,
        "congestion_factor": 2.0,
        "spike_amplitude_ms": 0.0,
        "spike_interval_s": 5.0,
        "spike_duration_s": 1.0,
        "jitter_pct": 0.05
    },
    "dmclock": {
        "admin": { "res": 50.0, "wgt": 200.0, "lim": 200.0 },
        "auth": { "res": 50.0, "wgt": 100.0, "lim": 100.0 },
        "data": { "res": 500.0, "wgt": 500.0, "lim": 5000.0 },
        "metadata": { "res": 100.0, "wgt": 200.0, "lim": 500.0 }
    },
    "op_costs": {
        "GetSmall": 1,
        "PutSmall": 2,
        "GetLarge": 8,
        "PutLarge": 12,
        "ListBucket": 10,
        "ProbeHealth": 1
    },
    "op_latency_multipliers": {
        "GetSmall": 1.0,
        "PutSmall": 1.2,
        "GetLarge": 2.5,
        "PutLarge": 3.0,
        "ListBucket": 3.0,
        "ProbeHealth": 0.5
    },
    "tenants": [
        {
            "name": "Tenant 1 [Control] Health Monitor",
            "role": "Cluster Health / K8s Liveness Probe",
            "client_id": "admin",
            "workers": 2,
            "pacing_ms": 50.0,
            "pacing_distribution": "constant",
            "op_weights": {
                "ProbeHealth": 100
            },
            "dmclock": {
                "res": 50.0,
                "wgt": 200.0,
                "lim": 200.0
            }
        },
        {
            "name": "Tenant 2 [Tier 1] High-Scale Ingestion VIP",
            "role": "Enterprise High-Throughput Ingestion (Platinum)",
            "client_id": "data",
            "workers": 64,
            "pacing_ms": 0.0,
            "pacing_distribution": "constant",
            "op_weights": {
                "GetSmall": 40,
                "PutSmall": 60
            },
            "dmclock": {
                "res": 4000.0,
                "wgt": 4000.0,
                "lim": 10000.0
            }
        },
        {
            "name": "Tenant 3 [Tier 2] Real-Time Web & Search",
            "role": "Production Query Microservices (Gold)",
            "client_id": "data",
            "workers": 32,
            "pacing_ms": 0.0,
